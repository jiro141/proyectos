# ─── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=poner-una-clave-segura-aqui-cambiar-en-produccion
ALLOWED_HOSTS=.pythonanywhere.com,localhost

# ─── Base de datos (PythonAnywhere MySQL) ────────────────────────────────
# Estos datos los obtenés de la pestaña "MySQL" en tu dashboard de PA
DB_ENGINE=django.db.backends.mysql
DB_NAME=tu_usuario$pizzeria
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña_mysql
DB_HOST=tu_usuario.mysql.pythonanywhere-services.com
DB_PORT=3306

# ─── CORS ────────────────────────────────────────────────────────────────
# URLs del frontend que pueden hacer peticiones (separadas por coma)
CORS_ALLOWED_ORIGINS=https://tu-dominio.netlify.app,capacitor://localhost

# ─── Firebase (opcional — solo si usás push notifications) ───────────────
# Se necesita el archivo firebase-credentials.json en la raíz del backend
